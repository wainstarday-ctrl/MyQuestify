# Виртуальные окружения. Образец со звёздочкой обязателен: правило
# «.venv/» не покрывает ни .venv-old, ни .venv312, а именно такие имена
# появляются при переустановке Python рядом с прежним.
.venv/
.venv*/
venv/
env/

# Результаты сборки
build/
dist/
release/
*.spec.bak

# Пакеты, скачанные вручную. Установочный файл llama-cpp-python весит
# десятки мегабайт и в репозитории не нужен: он привязан к версии Python
# и разрядности системы.
*.whl
*.tar.gz

# Байткод
__pycache__/
*.py[cod]

# Данные пользователя (создаются при запуске из исходников)
myquestify.db
myquestify.db-wal
myquestify.db-shm
myquestify.log*
uploads/

# Веса модели: сотни МБ, в git им не место
models/*.gguf

# Значки: создаются скриптом из кода, в репозитории не хранятся
assets/icon.ico
assets/icon.png
assets/icon.icns
assets/icon.iconset/

# Скриншоты хранятся в репозитории намеренно: они нужны README и меняются
# редко. Исключение из общего правила о бинарных файлах.
!docs/screenshots/*.png

# IDE
.vscode/
.idea/

# Мобильная сборка: www собирается из общих исходников, android/ создаётся
# Capacitor при первом запуске
mobile/www/
mobile/node_modules/
mobile/android/
mobile/android-icons/

# Ключ подписи приложения и пароли к нему: потеря ключа делает невозможным
# обновление уже установленного приложения, а огласка позволяет выпустить
# поддельное обновление от вашего имени
mobile/android/app/*.keystore
mobile/android/keystore.properties
release/
